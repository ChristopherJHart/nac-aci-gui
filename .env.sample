# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development

# Change request email (optional). When SMTP_HOST or CHANGE_REQUEST_EMAIL_TO is unset,
# no email is sent. The connection is always upgraded with STARTTLS (TLS 1.2+) before
# authenticating. Quote values containing '$' in single quotes.
#SMTP_HOST='smtp.example.com'
#SMTP_PORT='25'
#SMTP_USERNAME='service-account@example.com'
#SMTP_PASSWORD='change-me'
#CHANGE_REQUEST_EMAIL_TO='change-requests@example.com'
#CHANGE_REQUEST_EMAIL_FROM='service-account@example.com'
